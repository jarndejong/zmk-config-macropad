#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {
        select_line: select_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LG(LEFT)>
                , <&macro_tap &kp LS(LG(RIGHT))>
                ;
        };

        copy_line: copy_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &select_line>
                , <&macro_tap &kp LG(C)>
                ;
        };

        cut_line: cut_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &select_line>
                , <&macro_tap &kp LG(X)>
                ;
        };
        move_line_up: move_line_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LC(UP)>;
        };

        move_line_down: move_line_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LC(DOWN)>;
        };

        lint: lint {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LC(LA(L))>;
        };

        typing: typing {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LC(LA(T))>;
        };

        pytest: pytest {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LC(LA(P))>;
        };

        next_problem: next_problem {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp F8>;
        };

        previous_problem: previous_problem {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LS(F8)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";


        edit_layer {
            display-name = "EDIT";
            bindings = <
                &kp C_PREV          &kp LG(LS(Z))       &kp LG(Z)
                &kp C_PP            &kp DOWN            &kp UP
                &kp C_NEXT          &cut_line           &copy_line
                &to 1               &move_line_down     &move_line_up
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        dev_layer {
            display-name = "DEV";
            bindings = <
                &trans      &kp LC(LS(MINUS))   &kp LC(MINUS)
                &trans      &kp LC(GRAVE)       &lint
                &trans      &kp LG(B)           &typing
                &to 2       &next_problem       &previous_problem
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        BT_layer {
            display-name = "BT-Select";
            bindings = <
                &trans     &trans       &bt BT_SEL 0
                &trans     &trans       &bt BT_SEL 1   
                &trans     &trans       &bt BT_SEL 2
                &to 0      &bt BT_CLR   &bt BT_SEL 3       
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

    };
};
