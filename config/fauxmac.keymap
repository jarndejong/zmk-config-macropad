#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";


        base_layer {
            display-name = "BASE";
            bindings = <
                &kp C_PREV          &kp LG(Z)           &kp LG(C)
                &kp C_PP            &kp LG(LS(Z))       &kp LA(UP)
                &kp C_NEXT          &kp LG(V)           &kp LA(DOWN)
                &to 1               &kp LA(DOWN)LG(S)   &kp LA(UP)
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        dev_layer {
            display-name = "DEV";
            bindings = <
                &kp LC(LA(L))     &kp LC(LA(T))     &kp LC(LA(P))
                &kp LC(LS(MINUS)) &kp LC(GRAVE)     &kp UP
                &kp LC(MINUS)     &kp LG(B)         &kp DOWN 
                &to 0             &mo 2             &kp ENTER
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        BT_layer {
            display-name = "BT-Select";
            bindings = <
                &trans          &trans          &trans
                &trans          &trans          &trans
                &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2
                &to 0           &trans           &bt BT_CLR
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
